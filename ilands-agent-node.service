[Unit]
Description=Ubuntu Agent Node API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentnode
Group=agentnode
WorkingDirectory=/opt/ilands-agent-node
EnvironmentFile=/etc/ilands-agent-node.env
ExecStart=/opt/ilands-agent-node/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ilands-agent-node

[Install]
WantedBy=multi-user.target
